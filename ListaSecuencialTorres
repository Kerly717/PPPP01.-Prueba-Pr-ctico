public class ListaSecuencialTorres {

    private static final int CAPACIDAD_MAXIMA = 20;

    private Torre[] torres;
    private int contador;

    public ListaSecuencialTorres() {
        this.torres = new Torre[CAPACIDAD_MAXIMA];
        this.contador = 0;
    }

    public boolean insertarTorre(Torre nuevaTorre) {
        if (contador >= CAPACIDAD_MAXIMA) {
            System.out.println("No se puede registrar la torre: capacidad maxima alcanzada.");
            return false;
        }
        torres[contador] = nuevaTorre;
        contador++;
        return true;
    }


    public boolean eliminarTorrePorId(int id) {
        int indice = buscarIndicePorId(id);
        if (indice == -1) {
            return false;
        }
        for (int i = indice; i < contador - 1; i++) {
            torres[i] = torres[i + 1];
        }
        torres[contador - 1] = null;
        contador--;
        return true;
    }


    public Torre buscarTorrePorId(int id) {
        int indice = buscarIndicePorId(id);
        if (indice == -1) {
            return null;
        }
        return torres[indice];
    }

    private int buscarIndicePorId(int id) {
        for (int i = 0; i < contador; i++) {
            if (torres[i].getId() == id) {
                return i;
            }
        }
        return -1;
    }


    public void mostrarTorres() {
        if (contador == 0) {
            System.out.println("No hay torres registradas.");
            return;
        }
        System.out.println("--- Torres registradas (" + contador + ") ---");
        for (int i = 0; i < contador; i++) {
            System.out.println(torres[i]);
        }
    }


    public int contarActivas() {
        return contador;
    }

    public int getContador() {
        return contador;
    }

    public Torre obtenerTorreEnIndice(int indice) {
        if (indice < 0 || indice >= contador) {
            return null;
        }
        return torres[indice];
    }
}
