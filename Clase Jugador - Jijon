/**
 * Representa al jugador y sus vidas restantes.
 */
public class Jugador {

    private int vidas;

    public Jugador(int vidasIniciales) {
        this.vidas = vidasIniciales;
    }

  

    public void perderVida() {
        if (vidas > 0) {
            vidas--;
        }
    }

    public boolean estaDerrotado() {
        return vidas <= 0;
    }
}
