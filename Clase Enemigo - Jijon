/**
 * Clase de datos que representa a un enemigo, tal como lo pide la seccion 8
 * del documento guia (independiente del nodo que lo enlaza en la lista).
 */
public class Enemigo {

    private int id;
    private String tipo;
    private int vida;
    private int velocidad;
    private int posicion;
    private int recompensa;

    public Enemigo(int id, String tipo, int vida, int velocidad, int posicion, int recompensa) {
        this.id = id;
        this.tipo = tipo;
        this.vida = vida;
        this.velocidad = velocidad;
        this.posicion = posicion;
        this.recompensa = recompensa;
    }

    

    public void recibirDanio(int danio) {
        this.vida = this.vida - danio;
        if (this.vida < 0) {
            this.vida = 0;
        }
    }

    public boolean estaDestruido() {
        return this.vida <= 0;
    }

    @Override
    public String toString() {
        return "Enemigo #" + id + " [" + tipo + "] vida=" + vida
                + " vel=" + velocidad + " pos=" + posicion + " recompensa=" + recompensa;
    }
}
